---
import Section from '../layouts/Section.astro';

const leads = [
  ['مصطفى أحمد', 'قائد جمعة الخير'],
  ['حياة أحمد', 'رئيسة عيادة الباطنة'],
  ['مريم محمد', 'نائبة رئيس العيادة'],
  ['ملك إبراهيم', 'مسؤولة التنظيم'],
  ['مبين علاء', 'مسؤول الفحص'],
  ['عماد أسامة', 'مسؤول الصيدلية'],
  ['حامد شوقي البدوي', 'مشرف الصيدلية والبوابات'],
];
---
<Section
  key="team"
  title="الفريق"
  description="فريق أطباء الخير: طلاب طب وأطباء متطوعون في جمعية رسالة بمدينة نصر."
  lead="طلاب طب وأطباء شباب قرروا أن يقضوا يوم الجمعة في خدمة الناس. هنا بعض من يقفون وراء كل يوم خير."
  hero="grays-hospital"
  facts={[
    ['البداية', 'سبتمبر 2025'],
    ['التابعية', 'جمعية رسالة، مدينة نصر'],
    ['التكريم', 'درع هيرو الخير كل ربع سنة'],
  ]}
  gallery={['team-vehicle', 'annual-celebration', 'convoy-t3-team', 'clinic-team', 'team-thanks', 'bm-volunteers', 'convoy-growing-team']}
  galleryTitle="وجوه الفريق"
>
  <section>
    <h2>القيادة</h2>
    <ul class="rows">
      {leads.map(([n, r]) => <li><span class="row-main">{n}</span><span class="row-side">{r}</span></li>)}
    </ul>
  </section>
  <section>
    <h2>هيرو الخير</h2>
    <p>كل ربع سنة نكرّم المتطوعين الذين كانوا في الصف الأول: في القوافل، وفي العيادة، وفي كل إيفنت. وبعد كل قافلة نختار أفضل متطوع، ونكرّم أفضل الـHeads في النشاط.</p>
    <p>النجاح عندنا لا يكون شغل فرد. يبدأ دائمًا بفريق يحب أن يساعد بجد.</p>
  </section>
</Section>
