---
import Section from '../layouts/Section.astro';

const convoys = [
  ['غيث', 'مايو 2026'],
  ['VitFam، لصحة الأسرة كلها', 'مايو 2026'],
  ['حساسية الربيع تحت السيطرة', 'أبريل 2026'],
  ['قافلة استكشافية وتوعوية', 'يناير 2026'],
  ['T3 Care', 'أغسطس 2026'],
  ['Growing Healthy، مع أسبوع الرضاعة الطبيعية', 'أغسطس 2026'],
  ['Game of Stones، لصحة الكلى', 'أغسطس 2026'],
];
---
<Section
  key="convoys"
  title="القوافل الطبية"
  description="قوافل أطباء الخير الطبية: كشف مبدئي، وقياس ضغط وسكر، وتوعية صحية في المناطق الأكثر احتياجًا."
  lead="ننزل إلى القرى والمناطق الأكثر احتياجًا ومعنا ما يلزم لكشف مبدئي ومتابعة، ونترك وراءنا معلومة صحية تنفع البيت كله."
  hero="convoy-desk"
  facts={[
    ['الموعد', 'أغلب أيام الجمعة'],
    ['الخدمات', 'كشف، ضغط، سكر، توعية'],
    ['الفريق', 'طلاب طب وأطباء امتياز'],
  ]}
  gallery={['convoy-ghaith-1', 'convoy-child-bp', 'convoy-elder', 'convoy-history', 'convoy-talk', 'convoy-t3-team', 'convoy-women', 'convoy-ghaith-2', 'convoy-ghaith-3', 'convoy-growing-team', 'vest-volunteer', 'team-thanks']}
  galleryTitle="من القوافل"
  cta={{ title: 'انزل معنا في القافلة القادمة', text: 'نحتاج في كل قافلة أدوارًا مختلفة: التوعية، والكشف، وأخذ التاريخ المرضي، والتنظيم. طلاب الفرقة الخامسة وأطباء الامتياز مطلوبون دائمًا لأخذ التاريخ المرضي.', label: 'سجّل في استمارة التطوع' }}
>
  <section>
    <h2>ماذا يحدث في يوم القافلة</h2>
    <p>نستقبل الأهالي وننظم الدور، ثم يأخذ المتطوعون التاريخ المرضي، ويقيسون الضغط والسكر، ويكشف الأطباء كشفًا مبدئيًا ويوجّهون الحالات التي تحتاج متابعة. وفي كل قافلة ركن للتوعية الصحية، وأحيانًا سوق خيري بأسعار رمزية.</p>
  </section>
  <section>
    <h2>لكل قافلة اسم وموضوع</h2>
    <ul class="rows">
      {convoys.map(([n, d]) => <li><span class="row-main">{n}</span><span class="row-side">{d}</span></li>)}
    </ul>
  </section>
</Section>
